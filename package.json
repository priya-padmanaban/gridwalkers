{
  "name": "gridwalkers",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && esbuild server/generation-worker.ts --bundle --platform=node --outfile=server-build/generation-worker.cjs && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ioredis": "^5.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
